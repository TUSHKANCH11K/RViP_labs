# PostgreSQL. Для локального запуска приложений на хосте оставьте DB_HOST=localhost.
# В docker-compose сервисы сами подставляют DB_HOST=db.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contracts
DB_USER=contracts
DB_PASSWORD=contracts

# Адреса для локального запуска шлюза. В контейнере compose задает имена сервисов.
CONTRACT_SERVICE_URL=http://localhost:8081
REPORT_SERVICE_URL=http://localhost:8082
